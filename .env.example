# Copy to .env and fill in what you need. Nothing here is required for local
# dev or anonymous use - every value has a safe local default (see README).
# Referenced by docker-compose.yml and by the backend directly (os.getenv).

# --- Frontend -> backend URL (Next.js, must be set at build time) ---
# Leave unset for the combined single-container deploy (Dockerfile): the
# frontend calls same-origin "/api/*", which next.config.ts proxies to the
# backend running alongside it (see API_INTERNAL_URL below). Only set this
# when the frontend and backend are built and hosted as separate services.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL the frontend's "/api/*" proxy forwards to (Next.js server,
# read at runtime - no rebuild needed). Only needed when the backend isn't
# reachable at the combined image's default of http://127.0.0.1:8000.
# API_INTERNAL_URL=http://127.0.0.1:8000

# Public site URL (Next.js, must be set at build time). Used for SEO only -
# canonical links, Open Graph/Twitter card URLs, sitemap.xml, and robots.txt.
# Defaults to http://localhost:3000 if unset, which is fine for local dev but
# must be set to the real deployed origin (e.g. https://mindhx.example.com)
# for any production deployment so search engines and social previews link
# back to the right place.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend: accounts / auth ---
# Required for any real deployment. If unset, the backend generates a random
# per-process secret and logs a warning (fails safe: invalidates tokens on
# restart rather than shipping a guessable default).
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# How long a "forgot password" email link stays valid before it must be
# requested again.
PASSWORD_RESET_EXPIRE_MINUTES=30

# postgresql://user:password@host:5432/db - defaults to a local SQLite file
# (backend/mindhx.db) when unset, so local dev needs no database setup.
DATABASE_URL=

# Postgres container credentials (docker-compose.yml only; override for
# anything beyond local use).
POSTGRES_USER=mindhx
POSTGRES_PASSWORD=mindhx
POSTGRES_DB=mindhx

# Origin allowed by the backend's CORS policy. Also used to build the link
# inside password-reset emails (e.g. https://mindhx.example.com/reset-password?token=...),
# so set this to the real deployed frontend origin in production, not just
# an allowlist entry.
WEB_ORIGIN=http://localhost:3000

# --- Backend: password-reset email (SMTP) ---
# If SMTP_HOST is unset (the local-dev default), the reset email is printed
# to the backend's console/log instead of sent - so "forgot password" is
# fully testable with no email setup. Set all of these for a real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mindhx.local

# --- Backend: text analysis (Qwen via DashScope, preferred) ---
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Backend: text analysis fallback (OpenRouter) ---
# Used only if DASHSCOPE_API_KEY is unset; falls back further to a local
# heuristic classifier if this is unset too.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000

# --- Backend: Urdu text-to-speech (Uplift AI) ---
UPLIFT_API_KEY=
UPLIFT_VOICE_ID=v_8eelc901
UPLIFT_OUTPUT_FORMAT=MP3_22050_128

# --- Backend: transcription (hosted OpenAI Whisper API) ---
# Required for voice check-ins to work. Runs the same Whisper model family
# that used to run in-process, but hosted - avoids the memory footprint of
# loading the ctranslate2/onnxruntime runtime locally, which was enough to
# get the backend OOM-killed under a tight container memory limit even at
# the smallest model size.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# --- Backend: acoustic voice signal ---
# Only "local" (the built-in heuristic) is implemented today; provider-
# pluggable for a future validated voice-biomarker vendor.
VOICE_BIOMARKER_PROVIDER=local
